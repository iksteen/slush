// Action vocabulary shared by help and the command palette.
action "split" id=1 group="panes" label="split the longer way"
action "split-cols" id=2 group="panes" label="split into columns"
action "split-rows" id=3 group="panes" label="split into rows"
action "close-pane" id=4 group="panes" label="close this pane"
action "rerun" id=5 group="panes" label="run a finished pane again"
action "zoom" id=6 group="panes" label="fill the tab with it"
action "minimize" id=7 group="panes" label="put it away in the strip"
action "float" id=8 group="panes" label="float it above the layout"
action "new-float" id=9 group="panes" label="a new floating shell"
action "float-grow" id=10 group="size" label="grow a floating pane"
action "float-shrink" id=11 group="size" label="shrink a floating pane"
action "set-purpose" id=12 group="panes" label="tag it with a purpose"
action "rename-pane" id=13 group="panes" label="rename this pane"
action "rename-tab" id=14 group="tabs" label="rename this tab"
action "rotate-layout" id=15 group="size" label="turn the layout a quarter"
action "focus-left" id=16 group="focus" label="go left"
action "focus-right" id=17 group="focus" label="go right"
action "focus-up" id=18 group="focus" label="go up"
action "focus-down" id=19 group="focus" label="go down"
action "focus-next" id=20 group="focus" label="the next pane"
action "new-tab" id=21 group="tabs" label="new tab"
action "close-tab" id=22 group="tabs" label="close this tab"
action "next-tab" id=23 group="tabs" label="next tab"
action "prev-tab" id=24 group="tabs" label="previous tab"
action "finder" id=25 group="focus" label="find a pane by name"
action "palette" id=26 group="session" label="run a command"
action "workspaces" id=27 group="projects" label="go to a project"
action "save-workspace" id=28 group="projects" label="save this tab as a layout"
action "scroll-up" id=29 group="scroll" label="up a line"
action "scroll-down" id=30 group="scroll" label="down a line"
action "scroll-page-up" id=31 group="scroll" label="up a page"
action "scroll-page-down" id=32 group="scroll" label="down a page"
action "scroll-top" id=33 group="scroll" label="to the oldest line"
action "scroll-bottom" id=34 group="scroll" label="back to the present"
action "search" id=35 group="scroll" label="search the scrollback"
action "resize-left" id=36 group="size" label="move the boundary left"
action "resize-right" id=37 group="size" label="move the boundary right"
action "resize-up" id=38 group="size" label="move the boundary up"
action "resize-down" id=39 group="size" label="move the boundary down"
action "equalize" id=40 group="size" label="even out every split"
action "clear-shaders" id=41 group="panes" label="clear this pane's shaders"
action "pane-to-next-tab" id=42 group="panes" label="push it to the tab after"
action "pane-to-prev-tab" id=43 group="panes" label="push it to the tab before"
action "pane-to-new-tab" id=44 group="panes" label="into a tab of its own"
action "detach" id=45 group="session" label="detach, leave it running"
action "quit" id=46 group="session" label="quit the session"
action "help" id=47 group="session" label="this list"
action "edit-config" id=48 group="session" label="edit the config"
action "themes" id=49 group="session" label="change the theme"
action "literal-prefix" id=50 group="session" label="send the prefix itself"
action "select-tab-1" id=51 group="tabs" label="go to that tab"
