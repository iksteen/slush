// Runtime default palette for the Rust port, transcribed from slosh.
//
// Drop it in your theme directory and name it with
// `theme_name`. What each colour is for is written out in
// the shipped `default` theme.
theme {
    default_fg             "#ffffff"
    default_bg             "#000000"
    frame_focus            "#7aa2f7"
    frame_idle             "#45454a"
    title                  "#ffffff"
    title_idle             "#45454a"
    button_fg              "#141418"
    button_bg              "#7aa2f7"
    button_bg_idle         "#55555c"
    guide                  "#7aa2f7"
    resize                 "#7aa2f7"
    drop_target            "#7aa2f7"
    scroll_fg              "#141418"
    scroll_bg              "#7aa2f7"
    header                 "#45454a"
    header_hover           "#7aa2f7"
    header_hover_title     "#ffffff"
    tab_active_fg          "#141418"
    tab_active_bg          "#7aa2f7"
    tab_active_hover_fg    "#ffffff"
    tab_idle               "#8a8a95"
    tab_idle_bg            "#3b3b40"
    tab_hover              "#7aa2f7"
    prefix_fg              "#141418"
    prefix_bg              "#7aa2f7"
    tab_count              "#45454a"
    tab_status_fg          "#5a6a8f"
    tab_status_bg           // terminal default
    tab_status_busy        "#7aa2f7"
    tab_status_spinner     "#7aa2f7"
    tab_status_stripe      "#0e131d"
    status                 "#45454a"
    status_state           "#ffffff"
    finder_fg              "#ffffff"
    finder_bg              "#45454a"
    finder_sel_fg          "#141418"
    finder_sel_bg          "#7aa2f7"
    search_fg              "#ffffff"
    search_bg              "#4d4124"
    search_cur_fg          "#141418"
    search_cur_bg          "#f2c97a"
    bell                   "#e0af68"
    modal_fg               "#e8e8ea"
    modal_bg               "#1c1c22"
    modal_border           "#7aa2f7"
    modal_title            "#ffffff"
    modal_button           "#8a8a95"
    modal_button_hover     "#7aa2f7"
    dead                   "#ff875f"
    hint                   "#ffffff"
    minbar                 "#45454a"
    minbar_hover           "#7aa2f7"
    pane_button            "#45454a"
    pane_button_hover      "#7aa2f7"
    rename_fg              "#141418"
    rename_bg              "#7aa2f7"
    toast_fg               "#141418"
    toast_bg               "#7aa2f7"
    attach_fg              "#45454a"
    attach_bg               // terminal default
}
